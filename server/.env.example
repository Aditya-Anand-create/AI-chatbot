# Copy this file to .env (cp .env.example .env). Never commit .env.
# The defaults work with NO API key at all.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_chatbot
CLIENT_ORIGIN=http://localhost:5173

# --- LLM provider (any OpenAI-compatible API) ---
# Default: Pollinations - free, no signup, no key.
LLM_API_URL=https://text.pollinations.ai/openai
LLM_MODEL=openai
LLM_API_KEY=
# If the provider is down / rate-limited, reply with a labelled demo message instead of an error.
# Set to false to see real errors. Use LLM_API_URL=mock for fully offline demo mode.
LLM_FALLBACK_TO_MOCK=true

# Optional upgrade 1 - Groq free tier (key: https://console.groq.com/keys)
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=your_groq_key

# Optional upgrade 2 - OpenRouter free models (key: https://openrouter.ai/settings/keys, email signup, no card)
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=poolside/laguna-s-2.1:free
# LLM_API_KEY=your_openrouter_key

# Optional upgrade 3 - Gemini free tier (key: https://aistudio.google.com/apikey)
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your_gemini_key

# Number of past messages sent to the model each turn (context window control)
MAX_CONTEXT_MESSAGES=20
SYSTEM_PROMPT=You are a helpful, concise AI assistant.
